# Public site URL (used for metadata, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL="https://nivetra.com"

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL="nivetrabusiness@zohomail.in"
NEXT_PUBLIC_WHATSAPP=""            # digits only, e.g. 919000000000
NEXT_PUBLIC_LOCATION="India"
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_X=""
